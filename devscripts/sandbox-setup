#!/bin/bash

. "$(dirname "$0")/sandbox.conf"

set -ex

if [[ -z "$HOST_IP" ]]; then
  HOST_IP="$(ifconfig en0 | awk '$1 == "inet" { print $2 }')"
fi

docker sandbox create --name "$SANDBOX_NAME" --pull-template always claude "$PWD"
# FIXME not sure if this is the only thing we need
docker sandbox network proxy "$SANDBOX_NAME" --allow-host "$HOST_IP"

